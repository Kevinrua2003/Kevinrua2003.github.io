---
import Section from "../Section.astro";
import type { CV } from "@/lib/cv-types";
import type { UIStrings } from "@/lib/i18n";

const { data: CV, ui, className } = Astro.props as {
  data: CV;
  ui: UIStrings;
  className?: string;
};
const { summary } = CV.basics;

const words = summary.split(' ');
---

<Section className={className} title={ui.sections.about} eyebrow={"//"}>
  <p class="font-mono opacity-75 print:font-sans text-skin-hue font-semibold print:text-skin-base print:font-normal w-full select-none">
    {words.map((word) => (
      <span class="w-auto sm:hover:bg-skin-button-muted transition-all duration-200 sm:hover:cursor-none">{word}</span> <span> </span>
    ))}
  </p>
</Section>
