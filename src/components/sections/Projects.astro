---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";
import type { CV } from "@/lib/cv-types";
import type { UIStrings } from "@/lib/i18n";

const { data: CV, ui, className } = Astro.props as {
  data: CV;
  ui: UIStrings;
  className?: string;
};
const { projects = [] } = CV;
---

<Section id="projects" className={className} title={ui.sections.projects} eyebrow={"//"}>
  <div class="grid grid-cols-1 gap-4 xl:grid-cols-2 print:flex print:flex-col">
    {
      projects && projects.map(
        ({ url, description, highlights, name, isActive, github, stack }) => {
          return (
            <div
              class="group relative flex min-h-80 flex-col justify-between rounded-2xl bg-skin-button-muted/50 p-5 shadow-sm ring-1 ring-skin-muted transition-all duration-200 ease-out hover:shadow-lg hover:shadow-skin-hue/10 hover:ring-skin-hue/60 min-w-0"
            >
              <div class="flex flex-col gap-2">
                <div class='relative z-10 flex items-center justify-between gap-2 min-w-0'>
                  <div class="flex items-center gap-2 min-w-0">
                    <Icon data-ccursor="lift" name="mdi:folder-outline" class="size-4 shrink-0" />
                    <div class="flex items-center gap-[6px] min-w-0">
                      {isActive ? (
                        <a
                          class="group flex items-center gap-[6px] text-lg font-semibold decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue rounded-sm transition-all min-w-0"
                          href={url}
                          title={ui.projects.view(name)}
                          target="_blank"
                        >
                          <span class="truncate">{name}</span>
                          <span class="text-skin-hue transition ease-linear group-hover:-translate-y-0.5 group-hover:translate-x-0.5 shrink-0">
                            <Icon name="ri:arrow-up-line" class="rotate-45" />
                          </span>
                        </a>
                      ) : (
                        <span class="text-lg font-semibold truncate">{name}</span>
                      )}
                    </div>
                  </div>

                  {github && (
                    <a
                      data-ccursor="lift"
                      href={github}
                      title={ui.projects.viewGithub(name)}
                      aria-label={ui.projects.viewGithub(name)}
                      target="_blank"
                      rel="noopener"
                      class="opacity-75 hover:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue rounded-sm shrink-0"
                    >
                      <Icon name="mdi:github" width={24} height={24} />
                    </a>
                  )}
                </div>

                <p data-ccursor="noPadding" class='relative z-10 py-2 text-sm text-skin-base leading-relaxed break-words'>
                  {description}
                </p>
                <ul class='highlights-list z-10 mt-1 text-sm space-y-1.5 ml-4 list-disc'>
                  {highlights.map((highlight) => {
                    return <li data-ccursor class="break-words leading-relaxed text-skin-muted marker:text-skin-hue">{highlight}</li>;
                  })}
                </ul>
              </div>
              
              {stack && (
                <ul class="flex print:hidden flex-wrap gap-2 mt-4 pt-3 border-t border-skin-hue/10" aria-label={ui.projects.technologies}>
                  {Object.entries(stack).map(([label, icon]) => (
                    <li data-ccursor="lift" class="bg-skin-button-accent/10 border-skin-hue/25 text-skin-strong print:p-0 print:bg-transparent print:text-zinc-800 flex gap-1 items-center border-solid print:border-none border rounded-md px-2 py-0.5 text-xs backdrop-blur-sm group/stack">
                      {icon &&
                        <span class="flex gap-1 items-center">
                          <Icon name={icon} width={16} height={16} /> <span class="group-hover/stack:text-skin-hue transition-all duration-200">{label}</span>
                        </span>
                      }
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        },
      )
    }
  </div>
</Section>

<style>
  ul.highlights-list {
    @apply ml-4 list-disc space-y-1.5;
    li {
      @apply text-skin-muted marker:text-skin-hue;
    }
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 0.6rem;
  }

  footer span {
    border-radius: 6px;
    background: #eee;
    color: #444;
    font-size: 0.6rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }
</style>
