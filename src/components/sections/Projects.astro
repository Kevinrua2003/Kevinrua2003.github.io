---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";
import type { CV } from "@/lib/cv-types";
import type { UIStrings } from "@/lib/i18n";

const { data: CV, ui, className } = Astro.props as {
  data: CV;
  ui: UIStrings;
  className?: string;
};
const { projects = [] } = CV;
---

<Section id="projects" className={className} title={ui.sections.projects} eyebrow={"//"}>
  <div class="grid grid-cols-1 items-start gap-4 xl:grid-cols-2 print:flex print:flex-col">
    {
      projects && projects.map(
        ({ url, description, highlights, name, isActive, github, image, stack }) => {
          return (
            <div
              class="group relative flex min-h-80 flex-col justify-between rounded-2xl bg-skin-button-muted/50 p-5 shadow-sm ring-skin-muted transition-[box-shadow,ring-color] duration-200 ease-out hover:shadow-lg hover:shadow-skin-hue/10 hover:ring-skin-hue/60 min-w-0"
            >
              <div class="flex flex-col gap-2">
                {image && (
                  <div class="relative aspect-video w-full overflow-hidden rounded-xl ring-1 ring-skin-hue/15 transition-[box-shadow] duration-300 group-hover:ring-skin-hue/40">
                    <img
                      src={import.meta.env.BASE_URL + image.replace(/^\//, "")}
                      alt={ui.projects.imageAlt(name)}
                      loading="lazy"
                      decoding="async"
                      width={1280}
                      height={720}
                      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
                    />
                  </div>
                )}
                <div class='relative z-10 flex items-center justify-between gap-2 min-w-0'>
                  <div class="flex items-center gap-2 min-w-0">
                    <Icon data-ccursor="lift" name="mdi:folder-outline" class="size-4 shrink-0" />
                    <div class="flex items-center gap-[6px] min-w-0">
                      {isActive ? (
                        <a
                          class="group flex items-center gap-[6px] text-lg font-semibold decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue rounded-sm transition-colors min-w-0"
                          href={url}
                          title={ui.projects.view(name)}
                          target="_blank"
                        >
                          <span class="truncate">{name}</span>
                          <span class="text-skin-hue transition ease-linear group-hover:-translate-y-0.5 group-hover:translate-x-0.5 shrink-0">
                            <Icon name="ri:arrow-up-line" class="rotate-45" />
                          </span>
                        </a>
                      ) : (
                        <span class="text-lg font-semibold truncate">{name}</span>
                      )}
                    </div>
                  </div>

                  {github && (
                    <a
                      data-ccursor="lift"
                      href={github}
                      title={ui.projects.viewGithub(name)}
                      aria-label={ui.projects.viewGithub(name)}
                      target="_blank"
                      rel="noopener"
                      class="opacity-75 hover:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue rounded-sm shrink-0"
                    >
                      <Icon name="mdi:github" width={24} height={24} />
                    </a>
                  )}
                </div>

                <p data-ccursor="noPadding" class='relative z-10 py-2 text-sm text-skin-base leading-relaxed break-words'>
                  {description}
                </p>
                <div data-expanded="false" class="group/expand relative flex flex-col expand-container">
                  <div class="after:from-[color-mix(in_srgb,rgb(var(--color-button-muted))_50%,rgb(var(--color-fill)))] after:to-transparent flex relative flex-col print:!h-auto gap-4 print:gap-2 after:bg-gradient-to-t after:absolute after:bottom-0 after:w-full print:after:hidden after:h-12 after:content-[''] h-16 group-data-[expanded=true]/expand:after:hidden group-data-[expanded=true]/expand:h-auto overflow-hidden duration-200 ease-out">
                    <div class="flex flex-col gap-1">
                      <h3 class="print:font-bold print:pt-1" data-ccursor="lift">{ui.projects.highlights}</h3>
                      <ul class="text-skin-muted [&>li]:ml-4 flex list-disc flex-col gap-2 text-sm">
                        {highlights.map((highlight) => {
                          return <li data-ccursor class="break-words leading-relaxed">{highlight}</li>;
                        })}
                      </ul>
                    </div>
                  </div>
                  <button data-ccursor="lift" data-show-more={ui.projects.showMore} data-show-less={ui.projects.showLess} aria-expanded="false" class="print:hidden group/more w-fit items-center justify-center gap-1.5 text-xs underline text-skin-muted transition-colors hover:text-skin-hue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue rounded-sm flex expand-button">
                    <span class="expand-text">{ui.projects.showMore}</span>
                    <Icon name="ri:arrow-up-s-line" class="w-4 h-4 group-hover/more:translate-y-0.5 duration-200 ease-out group-data-[expanded=true]/expand:rotate-180" width={24} height={24}></Icon>
                  </button>
                </div>
              </div>
              
              {stack && (
                <ul class="flex print:hidden flex-wrap gap-2 mt-4 pt-3 border-t border-skin-hue/10" aria-label={ui.projects.technologies}>
                  {Object.entries(stack).map(([label, icon]) => (
                    <li data-ccursor="lift" class="bg-skin-button-accent/10 border-skin-hue/25 text-skin-strong print:p-0 print:bg-transparent print:text-zinc-800 flex gap-1 items-center border-solid print:border-none border rounded-md px-2 py-0.5 text-xs backdrop-blur-sm group/stack">
                      {icon &&
                        <span class="flex gap-1 items-center">
                          <Icon name={icon} width={16} height={16} /> <span class="group-hover/stack:text-skin-hue transition-colors duration-200">{label}</span>
                        </span>
                      }
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        },
      )
    }
  </div>
</Section>

<script>
  const expandButton = document.querySelectorAll<HTMLElement>('#projects .expand-button');

  function setExpanded(container: HTMLElement, expanded: boolean) {
    container.dataset.expanded = expanded ? 'true' : 'false';
    const button = container.querySelector<HTMLElement>('.expand-button')!;
    const expandText = button.querySelector<HTMLElement>('.expand-text')!;
    expandText.textContent = expanded ? button.dataset.showLess! : button.dataset.showMore!;
    button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
  }

  expandButton.forEach(button => {
    button.addEventListener('click', () => {
      const container = button.closest<HTMLElement>('.expand-container')!;
      const willExpand = container.dataset.expanded !== 'true';
      // Accordion: keep only the clicked card expanded, collapse the others.
      document.querySelectorAll<HTMLElement>('#projects .expand-container').forEach(other => {
        if (other !== container && other.dataset.expanded === 'true') setExpanded(other, false);
      });
      setExpanded(container, willExpand);
    });
  });
</script>

<style>
  li::marker {
    @apply text-skin-hue;
  }
  h4 {
    @apply max-w-min px-2;
  }
</style>
