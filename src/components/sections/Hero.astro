---
import Section from '@/components/Section.astro'
import Options from '@/components/Options.astro'
import { Icon } from 'astro-icon/components'
import type { CV } from '@/lib/cv-types'
import type { UIStrings, LangCode } from '@/lib/i18n'

const { data: CV, ui, lang, className } = Astro.props as {
  data: CV
  ui: UIStrings
  lang: LangCode
  className?: string
}
const { basics } = CV
const { name, label, location, email } = basics
const { city, region, address } = location
const locationLine = [address, city, region].filter(Boolean).join(", ")
---

<Section className={className}>
  <div class="w-full min-w-0">
    <section
      id="about"
      aria-label={ui.hero.aboutMe}
      class="group flex gap-2 flex-col items-center text-center rounded-3xl bg-skin-muted sm:bg-skin-button-muted p-4 transition-[box-shadow,background-color] duration-200 sm:hover:bg-skin-muted sm:hover:shadow-lg sm:hover:shadow-skin-hue/10 print:gap-0 print:p-2"
    >
      <div
        class="flex items-center text-center gap-4 print:gap-1"
      >
        <div class="flex flex-col items-center">
          <h1 class="font-bold tracking-tight text-balance">{name}</h1>
          <p data-ccursor="noPadding" class="mt-1 font-mono text-base font-medium text-skin-muted">
            {label}
          </p>
        </div>
      </div>
      {locationLine && (
        <div data-ccursor="noPadding" class='flex w-max gap-2 py-1 px-2 text-sm text-skin-muted'>
          <Icon class='print:hidden sm:group-hover:text-skin-hue' name='mdi:world' width={20} height={20} />
          {locationLine}
        </div>
      )}
      <div class="hidden print:block"><b>Contact: </b>{email}</div>
    </section>
  </div>
  <div class='flex flex-col gap-4 print:hidden'>
        <Options lang={lang} ui={ui} cv={CV} profiles={basics.profiles} />
  </div>
</Section>

<style>
  h1 {
    @apply text-4xl print:text-3xl;
  }
</style>

<script>
  // Disable dark mode before printing
  window.addEventListener('beforeprint', () => {
    document.documentElement.classList.remove('dark')
  })

  // Restore dark mode after printing
  window.addEventListener('afterprint', () => {
    const storedTheme = localStorage.theme
    const hasStoredTheme = 'theme' in localStorage
    const systemPrefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)'
    ).matches
    if (
      storedTheme === 'dark' ||
      (!hasStoredTheme && systemPrefersDark)
    ) {
      document.documentElement.classList.add('dark')
    }
  })
</script>
