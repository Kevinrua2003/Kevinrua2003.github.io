---
import Section from '@/components/Section.astro'
import Options from '@/components/Options.astro'
import { Icon } from 'astro-icon/components'
import type { CV } from '@/lib/cv-types'
import type { UIStrings, LangCode } from '@/lib/i18n'

const { data: CV, ui, lang, className } = Astro.props as {
  data: CV
  ui: UIStrings
  lang: LangCode
  className?: string
}
const { basics } = CV
const { name, label, location, email } = basics
const { city, region, address } = location
---

<Section className={className}>
  <div class="w-full min-w-0">
    <section
      id="about"
      aria-label={ui.hero.aboutMe}
      class="group flex gap-2 flex-col items-center text-center rounded-3xl bg-skin-muted sm:bg-skin-button-muted p-4 transition-all  sm:hover:bg-skin-muted print:gap-0 print:p-2"
    >
      <div
        class="flex items-center text-center gap-4 print:gap-1"
      >
        <div class="flex flex-col items-center">
          <h1 class=" font-semibold ">{name}</h1>
          <div class="overflow-hidden mt-1">
            <div class="font-mono font-bold text-xl lg:text-[1rem] lg:leading-[1rem]">
              <div data-ccursor="noPadding"  class=" p-1 group/subtitle relative flex gap-1  transition-all">
                <p class="font-mono font-medium text-xl lg:text-[1rem] lg:leading-[1rem]">
                  {label} 
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div data-ccursor="noPadding" class='flex w-max gap-2 py-1 px-2 text-sm text-skin-muted'>
        <Icon class='print:hidden sm:group-hover:text-skin-hue' name='mdi:world' width={20} height={20} />
        {address ? address + "," : ""} {city ? city + ", " : ""} {region ? region : ""}
      </div>
      <div class="hidden print:block"><b>Contact: </b>{email}</div>
    </section>
  </div>
  <div class='flex flex-col gap-4 print:hidden'>
        <nav
          aria-label="Navegación de secciones"
          class="flex flex-wrap items-center justify-evenly w-full rounded-3xl p-3 gap-1 transition-all bg-skin-muted sm:bg-skin-button-muted sm:hover:bg-skin-muted"
        >
          {
            [
              { id: 'experience', label: ui.sections.experience },
              { id: 'education', label: ui.sections.education },
              { id: 'projects', label: ui.sections.projects },
              { id: 'skills', label: ui.sections.skills },
              { id: 'contact', label: ui.sections.contact },
            ].map(({ id, label }) => (
              <a
                data-ccursor
                href={`#${id}`}
                class="font-mono text-xs font-semibold px-2.5 py-1.5 rounded-xl text-skin-muted hover:text-skin-hue hover:bg-skin-button-accent/20 transition-all cursor-pointer"
              >
                {label}
              </a>
            ))
          }
        </nav>
        <Options lang={lang} ui={ui} profiles={basics.profiles} />
  </div>
</Section>

<style>
  .info {
    @apply print:gap-0 print:pr-0;
    
    footer {
      @apply flex gap-4;
    }
  }

  h1 {
    @apply text-4xl font-bold print:text-3xl;
  }

  h2 {
    @apply text-balance text-base text-skin-muted print:text-lg;
  }

  img {
    @apply aspect-square w-32 rounded-2xl bg-cover;
  }

  span {
    @apply flex items-center gap-1 text-xs text-skin-hue;
  }

  footer {
    @apply flex gap-1;
  }
  

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      @apply pr-0 md:items-center md:justify-center;
    }

    figure {
      @apply flex md:items-center md:justify-center;
    }

    h2 {
      text-wrap: balance;
    }

    figure {
      @apply md:mx-auto;
    }
  }
</style>

<script>
  // Disable dark mode before printing
  window.addEventListener('beforeprint', () => {
    document.documentElement.classList.remove('dark')
  })

  // Restore dark mode after printing
  window.addEventListener('afterprint', () => {
    const storedTheme = localStorage.theme
    const hasStoredTheme = 'theme' in localStorage
    const systemPrefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)'
    ).matches
    if (
      storedTheme === 'dark' ||
      (!hasStoredTheme && systemPrefersDark)
    ) {
      document.documentElement.classList.add('dark')
    }
  })
</script>
