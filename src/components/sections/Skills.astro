---
import Section from '../Section.astro'
import { Icon } from 'astro-icon/components'
import type { CV } from '@/lib/cv-types'
import type { UIStrings } from '@/lib/i18n'

const { data: CV, ui, className } = Astro.props as {
  data: CV;
  ui: UIStrings;
  className?: string;
};
const { skills = [] } = CV;

// Duplicate skills array to make a seamless infinite marquee loop
const marqueeSkills = [...skills, ...skills];
---

<Section id="skills" className={className} title={ui.sections.skills} eyebrow={"//"}>
  <div class="flex flex-col gap-6 w-full overflow-hidden">
    <!-- Infinite Marquee Ticker Carousel -->
    <div class="relative w-full overflow-hidden rounded-2xl bg-skin-button-muted/40 p-4 border border-skin-hue/15 shadow-sm">
      <div class="absolute left-0 top-0 bottom-0 w-12 bg-gradient-to-r from-skin-fill to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-12 bg-gradient-to-l from-skin-fill to-transparent z-10 pointer-events-none"></div>

      <div class="flex w-max gap-4 animate-marquee hover:[animation-play-state:paused] py-1">
        {
          marqueeSkills.map((skill, index) => {
            const iconColor = skill.color || '#3b82f6';
            return (
              <div
                data-ccursor="lift"
                aria-hidden={index >= skills.length}
                class="flex items-center gap-2.5 rounded-xl border border-skin-hue/20 bg-skin-fill/90 px-4 py-2 text-xs font-semibold text-skin-base shadow-xs whitespace-nowrap shrink-0 transition-transform hover:scale-105"
              >
                {skill.icon && (
                  <Icon
                    name={skill.icon}
                    width={24}
                    height={24}
                    style={iconColor ? `color: ${iconColor};` : ''}
                    class="shrink-0"
                  />
                )}
                <span>{skill.name}</span>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</Section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    display: flex;
    animation: marquee 25s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none;
    }
  }
</style>
