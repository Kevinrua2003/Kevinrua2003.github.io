---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";
import type { CV } from "@/lib/cv-types";
import type { UIStrings } from "@/lib/i18n";

const { data: CV, ui, className } = Astro.props as {
  data: CV;
  ui: UIStrings;
  className?: string;
};

const { email } = CV.basics;
const web3FormsAccessKey = import.meta.env.WEB3FORMS_ACCESS_KEY || import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "";
---

<Section id="contact" className={className} title={ui.sections.contact} eyebrow={"//"}>
  <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-skin-button-muted/50 p-6 shadow-sm ring-skin-muted sm:hover:ring-skin-hue/50 transition-[box-shadow] duration-250 ease-in-out">
    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-send={ui.contact.send}
      data-sending={ui.contact.sending}
      data-success={ui.contact.success}
      data-error={ui.contact.error}
      class="flex flex-col gap-4"
    >
      <input type="hidden" name="access_key" value={web3FormsAccessKey} />
      <input type="hidden" name="from_name" value="Portfolio Contact Form" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-1.5">
          <label for="contact-name" class="text-xs font-mono font-semibold text-skin-muted uppercase tracking-wider">
            {ui.contact.name}
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            autocomplete="name"
            required
            placeholder={ui.contact.placeholderName}
            class="w-full rounded-xl bg-skin-fill/70 border border-skin-hue/20 px-3.5 py-2.5 text-sm text-skin-base placeholder:text-skin-muted/50 focus:border-skin-hue focus:outline-none focus:ring-1 focus:ring-skin-hue transition-colors"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="contact-email" class="text-xs font-mono font-semibold text-skin-muted uppercase tracking-wider">
            {ui.contact.email}
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            autocomplete="email"
            required
            placeholder={ui.contact.placeholderEmail}
            class="w-full rounded-xl bg-skin-fill/70 border border-skin-hue/20 px-3.5 py-2.5 text-sm text-skin-base placeholder:text-skin-muted/50 focus:border-skin-hue focus:outline-none focus:ring-1 focus:ring-skin-hue transition-colors"
          />
        </div>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="contact-subject" class="text-xs font-mono font-semibold text-skin-muted uppercase tracking-wider">
          {ui.contact.subject}
        </label>
        <input
          type="text"
          id="contact-subject"
          name="subject"
          required
          placeholder={ui.contact.placeholderSubject}
          class="w-full rounded-xl bg-skin-fill/70 border border-skin-hue/20 px-3.5 py-2.5 text-sm text-skin-base placeholder:text-skin-muted/50 focus:border-skin-hue focus:outline-none focus:ring-1 focus:ring-skin-hue transition-colors"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="contact-message" class="text-xs font-mono font-semibold text-skin-muted uppercase tracking-wider">
          {ui.contact.message}
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          placeholder={ui.contact.placeholderMessage}
          class="w-full rounded-xl bg-skin-fill/70 border border-skin-hue/20 px-3.5 py-2.5 text-sm text-skin-base placeholder:text-skin-muted/50 focus:border-skin-hue focus:outline-none focus:ring-1 focus:ring-skin-hue transition-colors resize-y min-h-24"
        ></textarea>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-2">
        <button
          type="submit"
          id="contact-submit"
          class="w-full sm:w-auto flex items-center justify-center gap-2 rounded-xl bg-skin-button-accent hover:bg-skin-button-accent-hover px-6 py-2.5 font-mono text-sm font-semibold text-white shadow-md hover:shadow-lg transition-[background-color,box-shadow,transform] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue focus-visible:ring-offset-2"
        >
          <Icon name="ri:send-plane-fill" width={18} height={18} />
          <span id="submit-text">{ui.contact.send}</span>
        </button>

        <a
          href={`mailto:${email}`}
          class="text-xs font-mono text-skin-muted hover:text-skin-hue transition-colors flex items-center gap-1.5"
        >
          <Icon name="mdi:email-outline" width={16} height={16} />
          <span>{email}</span>
        </a>
      </div>

      <div id="contact-status" role="status" aria-live="polite" class="hidden text-sm font-mono text-center p-3 rounded-xl"></div>
    </form>
  </div>
</Section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit');
  const submitText = document.getElementById('submit-text');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const accessKey = formData.get('access_key');

      // Si no hay access_key configurado en .env, abrimos cliente mailto como respaldo
      if (!accessKey || accessKey === 'YOUR_WEB3FORMS_ACCESS_KEY') {
        const name = formData.get('name');
        const email = formData.get('email');
        const subject = formData.get('subject');
        const message = formData.get('message');
        const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(`De: ${name} (${email})\n\n${message}`)}`;
        window.location.href = mailtoUrl;
        return;
      }

      if (submitBtn && submitText) {
        submitBtn.disabled = true;
        submitText.textContent = form.dataset.sending || '…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });
        const json = await response.json();
        
        if (status) {
          status.classList.remove('hidden', 'bg-red-500/20', 'text-red-600', 'dark:text-red-400', 'bg-green-500/20', 'text-green-600', 'dark:text-green-400');
          if (response.status === 200) {
            status.classList.add('bg-green-500/20', 'text-green-600', 'dark:text-green-400');
            status.textContent = json.message || form.dataset.success || 'OK';
            form.reset();
          } else {
            status.classList.add('bg-red-500/20', 'text-red-600', 'dark:text-red-400');
            status.textContent = json.message || form.dataset.error || 'Error';
          }
        }
      } catch (error) {
        if (status) {
          status.classList.remove('hidden');
          status.classList.add('bg-red-500/20', 'text-red-600', 'dark:text-red-400');
          status.textContent = form.dataset.error || 'Error';
        }
      } finally {
        if (submitBtn && submitText) {
          submitBtn.disabled = false;
          submitText.textContent = form.dataset.send || 'Send';
        }
      }
    });
  }
</script>
