---
import Section from '../Section.astro'
import type { CV } from '@/lib/cv-types'
import type { UIStrings } from '@/lib/i18n'

const { data: CV, ui, className } = Astro.props as {
  data: CV;
  ui: UIStrings;
  className?: string;
};
const { education = [] } = CV
---

<Section id="education" className={className} title={ui.sections.education} eyebrow={"//"}>
  <ul class='space-y-4 py-2 print:space-y-0'>
    {
      education.map(
        ({ institution, startDate, endDate, area, url }: { institution: string; startDate: string; endDate: string; area: string; url?: string }) => {
          const startYear = new Date(startDate).getFullYear()
          const endYear =
            endDate != null ? new Date(endDate).getFullYear() : ui.education.current
          const years = `${startYear} - ${endYear}`

          return (
            <li class='flex items-start gap-3 group/edu'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                width='24'
                height='24'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
                class='mt-1 hidden h-5 w-5 shrink-0 sm:inline-block print:hidden text-skin-hue'>
                <path d='M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z' />
                <path d='M22 10v6' />
                <path d='M6 12.5V16a6 3 0 0 0 12 0v-3.5' />
              </svg>
              <div class='flex flex-col sm:flex-row sm:items-start justify-between w-full gap-1.5 sm:gap-4 min-w-0'>
                <div class="flex flex-col min-w-0">
                  <h3 class='font-medium text-base sm:text-lg leading-snug break-words'>
                    {url ? (
                      <a
                        target='_blank'
                        rel="noreferrer noopener"
                        class='inline-block text-skin-base decoration-dotted underline-offset-4 hover:text-skin-hue hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue rounded-sm transition-all break-words'
                        href={url}>
                        {institution}
                      </a>
                    ) : (
                      <span class="text-skin-base break-words">{institution}</span>
                    )}
                  </h3>
                  <div class='text-sm text-skin-muted break-words mt-0.5'>{area}</div>
                </div>
                <time data-ccursor="lift" class='text-xs font-mono font-semibold text-skin-strong bg-skin-button-accent/15 border border-skin-hue/20 px-2 py-0.5 rounded-md w-fit shrink-0 self-start mt-0.5 sm:mt-1'>
                  {years}
                </time>
              </div>
            </li>
          )
        }
      )
    }
  </ul>
</Section>
