---
import { Icon } from "astro-icon/components";
import type { CV } from "@/lib/cv-types";
import type { ResumeLabels } from "@/lib/resume-engine";
import { toCvJson } from "@/lib/resume-engine";

interface Props {
  cv: CV;
  labels: ResumeLabels;
}

const { cv, labels } = Astro.props;
const cvJson = toCvJson(cv);
---

<span
  class="relative flex flex-row items-center gap-1"
  data-resume-root
  data-resume-cv={JSON.stringify(cvJson)}
  data-resume-labels={JSON.stringify(labels)}
>
  <button
    data-ccursor
    type="button"
    data-resume-toggle
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={labels.downloadCv}
    class="flex items-center justify-center rounded-md p-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue disabled:opacity-60"
  >
    <Icon name="ri:file-pdf-line" width={22} height={22} />
    <span data-resume-text class="font-mono text-xs font-bold ml-1">CV</span>
    <Icon
      name="ri:arrow-down-s-line"
      width={16}
      height={16}
      data-open="false"
      class="ml-0.5 transition-transform duration-200 data-[open=true]:rotate-180"
    />
  </button>

  <div
    data-resume-menu
    role="menu"
    aria-label={labels.downloadCv}
    class="hidden absolute top-full z-20 mt-2 min-w-36 rounded-xl border border-skin-hue/20 bg-skin-button-muted/95 p-1 shadow-lg backdrop-blur-sm"
  >
    <button
      data-ccursor
      type="button"
      data-resume-item="pdf"
      role="menuitem"
      aria-label={`${labels.downloadCv} (PDF)`}
      class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left font-mono text-xs font-semibold text-skin-muted transition-colors hover:bg-skin-button-accent/15 hover:text-skin-hue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue disabled:opacity-50"
    >
      <Icon name="ri:file-pdf-line" width={16} height={16} />
      <span>PDF</span>
    </button>
    <button
      data-ccursor
      type="button"
      data-resume-item="docx"
      role="menuitem"
      aria-label={`${labels.downloadCv} (DOCX)`}
      class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left font-mono text-xs font-semibold text-skin-muted transition-colors hover:bg-skin-button-accent/15 hover:text-skin-hue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue disabled:opacity-50"
    >
      <Icon name="ri:file-word-line" width={16} height={16} />
      <span>DOCX</span>
    </button>
  </div>
</span>

<script>
  import type { CvJson, ResumeLabels } from "@/lib/resume-engine";

  const root = document.querySelector<HTMLElement>("[data-resume-root]");
  if (root) {
    const cv = JSON.parse(root.dataset.resumeCv || "{}") as CvJson;
    const labels = JSON.parse(
      root.dataset.resumeLabels || "{}",
    ) as ResumeLabels;
    const toggle =
      root.querySelector<HTMLButtonElement>("[data-resume-toggle]");
    const menu = root.querySelector<HTMLElement>("[data-resume-menu]");
    const text = root.querySelector<HTMLElement>("[data-resume-text]");
    const chevron = root.querySelector<HTMLElement>("[data-open]");
    const items = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-resume-item]"),
    );
    let busy = false;

    const isOpen = (): boolean =>
      !!menu && !menu.classList.contains("hidden");

    const setMenu = (open: boolean) => {
      menu?.classList.toggle("hidden", !open);
      toggle?.setAttribute("aria-expanded", String(open));
      if (chevron) chevron.dataset.open = String(open);
    };

    // Abrir/cerrar con el botón CV
    toggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (busy) return;
      setMenu(!isOpen());
    });

    // Cerrar al hacer clic fuera
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) setMenu(false);
    });

    // Cerrar con Escape y devolver el foco al botón
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setMenu(false);
        toggle?.focus();
      }
    });

    // Abrir el menú con las flechas desde el botón
    toggle?.addEventListener("keydown", (e) => {
      if ((e.key === "ArrowDown" || e.key === "ArrowUp") && !isOpen()) {
        e.preventDefault();
        setMenu(true);
        items[0]?.focus();
      }
    });

    // Navegación con teclado dentro del menú
    menu?.addEventListener("keydown", (e) => {
      const idx = items.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === "ArrowDown") {
        e.preventDefault();
        items[(idx + 1) % items.length]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        items[(idx - 1 + items.length) % items.length]?.focus();
      } else if (e.key === "Home") {
        e.preventDefault();
        items[0]?.focus();
      } else if (e.key === "End") {
        e.preventDefault();
        items[items.length - 1]?.focus();
      }
    });

    const setBusy = (value: boolean) => {
      busy = value;
      if (toggle) toggle.disabled = value;
      items.forEach((item) => (item.disabled = value));
      if (text) text.textContent = value ? labels.generating : "CV";
    };

    const handle = async (action: "pdf" | "docx") => {
      if (busy) return;
      setMenu(false);
      setBusy(true);
      try {
        if (action === "pdf") {
          const [{ exportCvToPdf, defaultFilename }] = await Promise.all([
            import("@/lib/resume-engine"),
          ]);
          await exportCvToPdf(cv, labels, {
            filename: defaultFilename(cv.basics.name, "pdf", labels.fileSuffix),
          });
        } else {
          const [{ exportToDocx, defaultFilename }] = await Promise.all([
            import("@/lib/resume-engine"),
          ]);
          await exportToDocx(
            cv,
            labels,
            defaultFilename(cv.basics.name, "docx", labels.fileSuffix),
          );
        }
      } catch (err) {
        console.error("[resume-engine] Error al generar el documento:", err);
      } finally {
        setBusy(false);
      }
    };

    items.forEach((item) => {
      item.addEventListener("click", () =>
        handle(item.dataset.resumeItem as "pdf" | "docx"),
      );
    });
  }
</script>
