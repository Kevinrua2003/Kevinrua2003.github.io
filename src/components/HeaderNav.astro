---
import type { UIStrings } from '@/lib/i18n';

const { ui } = Astro.props as {
  ui: UIStrings;
};

const navItems = [
  { id: 'about', label: ui.sections.about },
  { id: 'experience', label: ui.sections.experience },
  { id: 'education', label: ui.sections.education },
  { id: 'projects', label: ui.sections.projects },
  { id: 'skills', label: ui.sections.skills },
  { id: 'contact', label: ui.sections.contact },
];
---

<header class="fixed top-0 left-0 right-0 z-50 w-full flex items-center justify-center py-2 px-2 sm:py-2.5 sm:px-6 bg-skin-fill/80 backdrop-blur-md border-b border-skin-hue/15 shadow-sm print:hidden">
  <nav
    aria-label={ui.nav.main}
    class="flex flex-row items-center justify-center flex-wrap sm:flex-nowrap max-w-full gap-1 sm:gap-2 rounded-full bg-skin-button-muted/90 px-2 sm:px-4 py-1 sm:py-1.5 border border-skin-hue/20 transition-all"
  >
    {
      navItems.map(({ id, label }) => (
        <a
          data-ccursor
          href={`#${id}`}
          class="font-mono text-xs font-semibold px-2 py-1 sm:px-3 sm:py-1.5 rounded-full text-skin-muted hover:text-skin-hue hover:bg-skin-button-accent/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue transition-all whitespace-nowrap"
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>
