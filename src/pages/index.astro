---
import '../globals.css'
import { DEFAULT_LANG, getCV, getUI } from '@/lib/i18n'

const cv = getCV(DEFAULT_LANG)
const ui = getUI(DEFAULT_LANG)
const target = `${import.meta.env.BASE_URL}${DEFAULT_LANG}/`
const siteBase = `${(Astro.site ?? '').toString().replace(/\/$/, '')}${import.meta.env.BASE_URL}`
const canonical = `${siteBase}${DEFAULT_LANG}/`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>{cv.basics.name} — {ui.seo.skipToContent}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body class="relative bg-skin-fill text-skin-base font-sans">
    <main class="flex min-h-screen w-full flex-col items-center justify-center gap-6 p-8 text-center">
      <div class="flex h-12 w-12 items-center justify-center rounded-full border-4 border-skin-muted border-t-skin-hue animate-spin" role="status" aria-label="loading"></div>
      <div class="flex flex-col items-center gap-1">
        <h1 class="text-xl font-bold tracking-tight">{cv.basics.name}</h1>
        <p class="font-mono text-sm text-skin-muted">{ui.seo.skipToContent}</p>
      </div>
      <a href={target} class="text-xs font-mono text-skin-muted underline decoration-dotted underline-offset-4 hover:text-skin-hue transition-colors">
        {target}
      </a>
    </main>
    <script is:inline>
      window.location.replace({redirect: target});
    </script>
  </body>
</html>